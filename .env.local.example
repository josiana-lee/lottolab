# --- 필수 ---
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres"

# --- 선택: 푸시 알림 ---
# 비워두면 푸시만 비활성화되고 나머지 기능은 정상 동작합니다.
# 키 생성: npx web-push generate-vapid-keys
VAPID_EMAIL="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- 선택: /api/draws/sync 보호 ---
# 비워두면 인증 없이 호출 가능합니다(로컬 개발용). 배포 시 반드시 설정하세요.
# Vercel Cron은 이 값을 Authorization: Bearer <값> 형태로 자동 전송합니다.
# GitHub Actions에서 호출한다면 동일한 값을 리포지토리 Secret(CRON_SECRET)에도 등록해야 합니다.
CRON_SECRET=""
